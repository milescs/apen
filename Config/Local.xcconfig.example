// Optional. scripts/install.sh creates Config/Local.xcconfig automatically when it finds an
// "Apple Development" certificate. To set it by hand, copy this file to Config/Local.xcconfig.
// Signing with your team lets macOS keep Apen's Microphone and Accessibility permissions across rebuilds.
// Your team ID is the OU field of: security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development
